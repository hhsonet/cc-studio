# Copy to .env and adjust. All values are optional.

# Port this app listens on (Caddy proxies to it)
PORT=3000

# Docker image used to compile and run code. Must already be pulled: docker pull gcc:13
RUNNER_IMAGE=gcc:13

# Per-IP limits trust X-Forwarded-For when the connection comes from loopback
# (Caddy on the same host). Set to "false" if the app is exposed with no proxy in front.
# TRUST_PROXY=false
