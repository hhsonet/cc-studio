# Copy to .env and adjust. Every value is optional; the defaults are shown.

# Port the server listens on (a reverse proxy such as Caddy forwards to it)
PORT=3000

# Docker image used to compile and run code. It must already be pulled: docker pull gcc:13
RUNNER_IMAGE=gcc:13

# Per-IP limits trust X-Forwarded-For when the connection comes from loopback
# (a reverse proxy on the same host). Set to "false" if nothing is in front of the app.
# TRUST_PROXY=false

# Capacity and abuse limits
# MAX_SESSIONS=200        # programs alive at once
# MAX_COMPILES=7          # container starts + compiles at once (default: CPU cores - 1)
# RUNS_PER_MINUTE=60      # runs per IP per minute
# CONNS_PER_IP=30         # simultaneous connections per IP
